2. Predict the bug’s future position (k steps ahead)
Assume hand will follow some known path (e.g., you keep moving in same direction, or frozen).
You just repeatedly apply the update function.


///////////////////////////
def bug_step(bx, by, hx, hy, bridge_y, bridge_h, speed, Rh, Rv):
    dx = bx - hx
    dy = by - hy

    # vertical: hide under bridge if hand is above and close
    if hy < by and abs(dy) < Rv:
        center = bridge_y + bridge_h / 2
        if by > center:
            by -= speed
        elif by < center:
            by += speed

    # horizontal: run away if close
    if abs(dx) < Rh:
        if hx < bx:
            bx += speed
        elif hx > bx:
            bx -= speed

    return bx, by

def predict_future_bug_positions(bx, by, hand_traj, steps,
                                 bridge_y, bridge_h, speed=3, Rh=150, Rv=200):
    """
    hand_traj: list of (hx, hy) or a function step -> (hx, hy)
    """
    path = [(bx, by)]
    for t in range(steps):
        if callable(hand_traj):
            hx, hy = hand_traj(t)
        else:
            hx, hy = hand_traj[min(t, len(hand_traj)-1)]

        bx, by = bug_step(bx, by, hx, hy, bridge_y, bridge_h, speed, Rh, Rv)
        path.append((bx, by))
    return path

//////////////////////////////

Now you can forecast where the bug will be after N frames given your hand path.

