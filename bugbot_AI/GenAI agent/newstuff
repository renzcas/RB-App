import matplotlib.pyplot as plt

def plot_trajectory(bx0, by0, hand_traj, steps, width=600, height=600):
    bridge_y = height // 2
    bridge_h = 40

    path = predict_future_bug_positions(
        bx0, by0, hand_traj, steps, bridge_y, bridge_h
    )

    xs, ys = zip(*path)

    plt.figure(figsize=(5, 5))
    plt.xlim(0, width)
    plt.ylim(0, height)
    plt.gca().invert_yaxis()  # so "up" is visually up

    # bridge
    plt.axhspan(bridge_y, bridge_y + bridge_h, color="gray", alpha=0.3, label="Bridge")

    # bug path
    plt.plot(xs, ys, "-o", color="red", label="Bug trajectory")

    # start/end
    plt.scatter([xs[0]], [ys[0]], c="green", label="Start")
    plt.scatter([xs[-1]], [ys[-1]], c="black", label="End")

    plt.legend()
    plt.title("Predicted bug escape trajectory")
    plt.show()

