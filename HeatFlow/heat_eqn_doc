import numpy as np
import matplotlib.pyplot as plt

nx, nt = 50, 100
dx, dt = 1.0/nx, 0.001
alpha = 0.01

u = np.zeros(nx)
u[nx//2] = 1  # initial heat spike

for t in range(nt):
    u[1:-1] += alpha * dt/dx**2 * (u[2:] - 2*u[1:-1] + u[:-2])

plt.plot(u)
plt.show()

