import torch
import torch.nn as nn

class Net(nn.Module):
    def __init__(self):
        super().__init__()
        self.layers = nn.Sequential(
            nn.Linear(2, 64), nn.Tanh(),
            nn.Linear(64, 64), nn.Tanh(),
            nn.Linear(64, 1)
        )
    def forward(self, x, t):
        inp = torch.cat([x, t], dim=1)
        return self.layers(inp)

# PDE residual: du/dt - alpha * d2u/dx2
def pde_residual(model, x, t, alpha=0.01):
    u = model(x, t)
    grads = torch.autograd.grad(u, [x, t], grad_outputs=torch.ones_like(u), create_graph=True)
    du_dx, du_dt = grads[0], grads[1]
    d2u_dx2 = torch.autograd.grad(du_dx, x, grad_outputs=torch.ones_like(du_dx), create_graph=True)[0]
    return du_dt - alpha * d2u_dx2
